# SMTP server: Gmail supports smtp.gmail.com:587 with STARTTLS or port 465 with SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Quan ly tien phong tro

# Day of month from which the automatic sender starts sending invoices.
# Keep 1 to start from day 1, or set another day from 1 to 28.
SEND_DAY=1

# If true, the scheduled script only sends invoices whose status is Chua thanh toan.
# false means every tenant with an email receives the monthly invoice.
AUTO_EMAIL_ONLY_UNPAID=false

# Optional: keep the SQLite file at a specific path. Leave commented to use the project folder.
# RENTAL_DB_PATH=C:/quan-ly-tien-tro/quan_ly_tien_tro.sqlite3

# Optional initial room count used only if no monthly settings exist yet.
DEFAULT_ROOMS=10
